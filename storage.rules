rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  match /products/{file} {
   allow read: if true;
   allow write: if request.auth != null && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.enabled == true && (request.resource == null || (request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)')));
  }
  match /{allPaths=**} { allow read, write: if false; }
 }
}
