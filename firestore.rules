rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function admin() { return request.auth != null && request.auth.token.admin == true; }
  match /products/{id} { allow read: if true; allow write: if admin(); }
  match /publicSettings/{id} { allow read: if true; allow write: if admin(); }
  match /orders/{id} { allow read: if admin() || (request.auth != null && resource.data.customerUid == request.auth.uid); allow write: if false; }
  match /{document=**} { allow read, write: if false; }
 }
}
