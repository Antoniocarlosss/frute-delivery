rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function admin() { return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true; }
  match /admins/{uid} { allow get: if request.auth != null && request.auth.uid == uid; allow list, write: if false; }
  match /products/{id} {
   allow read: if true;
   allow create, update: if admin()
    && request.resource.data.keys().hasOnly(['id','nome','descricao','categoria','imagem','precos','ativo'])
    && request.resource.data.id == id
    && id.matches('[a-zA-Z0-9_-]{1,80}')
    && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 100
    && request.resource.data.descricao is string && request.resource.data.descricao.size() <= 1000
    && request.resource.data.categoria is string && request.resource.data.categoria.size() > 0 && request.resource.data.categoria.size() <= 100
    && request.resource.data.imagem is string && request.resource.data.imagem.size() <= 160000
    && request.resource.data.ativo is bool
    && request.resource.data.precos.keys().hasOnly(['400','500'])
    && request.resource.data.precos['400'] is int && request.resource.data.precos['400'] > 0 && request.resource.data.precos['400'] <= 1000000
    && request.resource.data.precos['500'] is int && request.resource.data.precos['500'] > 0 && request.resource.data.precos['500'] <= 1000000;
   allow delete: if admin();
  }
  match /publicSettings/store { allow read: if true; allow write: if admin() && request.resource.data.keys().hasOnly(['nome','whatsapp','aberta','areas']) && request.resource.data.nome is string && request.resource.data.nome.size() <= 100 && request.resource.data.whatsapp is string && request.resource.data.whatsapp.matches('[0-9]{10,15}') && request.resource.data.aberta is bool && request.resource.data.areas is list && request.resource.data.areas.size() <= 100; }
  match /orders/{id} { allow read: if admin() || (request.auth != null && resource.data.customerUid == request.auth.uid); allow write: if false; }
  match /{document=**} { allow read, write: if false; }
 }
}
